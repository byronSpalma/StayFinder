{
  "name": "stayfinder-hono-api",
  "version": "1.0.0",
  "description": "StayFinder API - a Hono + TypeScript backend using Supabase (PostgreSQL) as the database",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "build:frontend": "tsc -p frontend/tsconfig.json",
    "dev:frontend": "tsc -p frontend/tsconfig.json --watch",
    "start": "node --env-file=.env dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.2",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.9",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
