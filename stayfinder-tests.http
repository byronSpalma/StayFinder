GET {{baseUrl}}/properties?sort=price_desc

# ============================================================================
# G9: Logged-in user can book from detail page
# ============================================================================

### Create booking without token (should return 401)
POST {{baseUrl}}/bookings
Content-Type: application/json

{
  "property_id": "{{propertyIdOutlook}}",
  "guest_name": "Test Guest",
  "guest_email": "guest@example.com",
  "check_in": "2026-12-01",
  "check_out": "2026-12-03",
  "guests": 2
}

### Create booking with token (should return 201)
POST {{baseUrl}}/bookings
Content-Type: application/json
Authorization: Bearer {{tokenYahoo}}

{
  "property_id": "{{propertyIdOutlook}}",
  "guest_name": "Test Guest",
  "guest_email": "guest@example.com",
  "check_in": "2026-12-01",
  "check_out": "2026-12-03",
  "guests": 2
}

# ============================================================================
# G10: Invalid bookings are rejected
# ============================================================================

### Create booking with invalid email (should return 400)
POST {{baseUrl}}/bookings
Content-Type: application/json
Authorization: Bearer {{tokenYahoo}}

{
  "property_id": "{{propertyIdOutlook}}",
  "guest_name": "Test Guest",
  "guest_email": "not-an-email",
  "check_in": "2026-12-01",
  "check_out": "2026-12-03",
  "guests": 2
}

### Create booking with zero guests (should return 400)
POST {{baseUrl}}/bookings
Content-Type: application/json
Authorization: Bearer {{tokenYahoo}}

{
  "property_id": "{{propertyIdOutlook}}",
  "guest_name": "Test Guest",
  "guest_email": "guest@example.com",
  "check_in": "2026-12-01",
  "check_out": "2026-12-03",
  "guests": 0
}

### Create booking with check_out before check_in (should return 400)
POST {{baseUrl}}/bookings
Content-Type: application/json
Authorization: Bearer {{tokenYahoo}}

{
  "property_id": "{{propertyIdOutlook}}",
  "guest_name": "Test Guest",
  "guest_email": "guest@example.com",
  "check_in": "2026-12-05",
  "check_out": "2026-12-03",
  "guests": 2
}

### Create booking with check_in in the past (should return 400)
POST {{baseUrl}}/bookings
Content-Type: application/json
Authorization: Bearer {{tokenYahoo}}

{
  "property_id": "{{propertyIdOutlook}}",
  "guest_name": "Test Guest",
  "guest_email": "guest@example.com",
  "check_in": "2020-01-01",
  "check_out": "2020-01-03",
  "guests": 2
}

### Create booking with too many guests (should return 400)
POST {{baseUrl}}/bookings
Content-Type: application/json
Authorization: Bearer {{tokenYahoo}}

{
  "property_id": "{{propertyIdOutlook}}",
  "guest_name": "Test Guest",
  "guest_email": "guest@example.com",
  "check_in": "2026-12-01",
  "check_out": "2026-12-03",
  "guests": 99
}

### Create booking with non-existent property (should return 404)
POST {{baseUrl}}/bookings
Content-Type: application/json
Authorization: Bearer {{tokenYahoo}}

{
  "property_id": "nonexistent",
  "guest_name": "Test Guest",
  "guest_email": "guest@example.com",
  "check_in": "2026-12-01",
  "check_out": "2026-12-03",
  "guests": 2
}

# ============================================================================
# G11: Booking form shows nights and total price
# ============================================================================

# This is a frontend feature, not testable via API.

# ============================================================================
# G12: Logged-in user can see, edit, delete bookings
# ============================================================================

### Get all bookings without token (should return 401)
GET {{baseUrl}}/bookings

### Get all bookings with token (should return 200)
GET {{baseUrl}}/bookings
Authorization: Bearer {{tokenYahoo}}

### Get a single booking (should return 200)
GET {{baseUrl}}/bookings/{{bookingIdYahoo}}
Authorization: Bearer {{tokenYahoo}}

### Get a non-existent booking (should return 404)
GET {{baseUrl}}/bookings/nonexistent
Authorization: Bearer {{tokenYahoo}}

### Update booking without token (should return 401)
PUT {{baseUrl}}/bookings/{{bookingIdYahoo}}
Content-Type: application/json

{
  "property_id": "{{propertyIdOutlook}}",
  "guest_name": "Updated Guest",
  "guest_email": "updated@example.com",
  "check_in": "2026-12-01",
  "check_out": "2026-12-03",
  "guests": 2
}

### Update own booking (should return 200)
PUT {{baseUrl}}/bookings/{{testBookingId}}
Content-Type: application/json
Authorization: Bearer {{tokenYahoo}}

{
  "property_id": "{{propertyIdOutlook}}",
  "guest_name": "Updated Guest",
  "guest_email": "updated@example.com",
  "check_in": "2026-12-01",
  "check_out": "2026-12-03",
  "guests": 2
}

### Update someone else's booking (should return 404)
PUT {{baseUrl}}/bookings/{{bookingIdYahoo}}
Content-Type: application/json
Authorization: Bearer {{tokenOutlook}}

{
  "property_id": "{{propertyIdOutlook}}",
  "guest_name": "Hacked Guest",
  "guest_email": "hacked@example.com",
  "check_in": "2026-12-01",
  "check_out": "2026-12-03",
  "guests": 2
}

### Cancel booking (should return 200)
PATCH {{baseUrl}}/bookings/{{testBookingId}}
Content-Type: application/json
Authorization: Bearer {{tokenYahoo}}

{
  "status": "cancelled"
}

### Delete booking without token (should return 401)
DELETE {{baseUrl}}/bookings/{{bookingIdYahoo}}

### Delete own booking (should return 200)
DELETE {{baseUrl}}/bookings/{{testBookingId}}
Authorization: Bearer {{tokenYahoo}}

### Delete someone else's booking (should return 404)
DELETE {{baseUrl}}/bookings/{{bookingIdYahoo}}
Authorization: Bearer {{tokenOutlook}}

