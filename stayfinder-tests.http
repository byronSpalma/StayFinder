# StayFinder API Tests
# VS Code REST Client format
# 
# INSTRUCTIONS:
# 1. Install the "REST Client" extension in VS Code.
# 2. Replace the placeholder values below with your actual tokens and IDs.
# 3. Run tests by clicking "Send Request" above each block.
# 4. Never commit real tokens or passwords to version control.
#
# VARIABLES (replace with your own values):
@baseUrl = http://localhost:3000
@tokenOutlook = YOUR_ACCESS_TOKEN_OUTLOOK
@tokenYahoo = YOUR_ACCESS_TOKEN_YAHOO
@propertyIdOutlook = property_793ed564
@bookingIdYahoo = booking_2479
@testPropertyId = property_280651ea
@testBookingId = booking_1403

# ============================================================================
# G1: Register, login, logout
# ============================================================================

### Register a new user (should return 201 with email_confirmation_required)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "TestPassword123!"
}

### Register with invalid email (should return 400)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "TestPassword123!"
}

### Register with short password (should return 400)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "short"
}

### Login with valid credentials (should return 200 with tokens)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user1@example.com",
  "password": "YourPassword123!"
}

### Login with invalid credentials (should return 401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user1@example.com",
  "password": "WrongPassword"
}

### Login with unconfirmed email (should return 403)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "unconfirmed@example.com",
  "password": "TestPassword123!"
}

### Get current user (should return 200 with user info)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{tokenOutlook}}

### Get current user without token (should return 401)
GET {{baseUrl}}/auth/me

### Get current user with invalid token (should return 401)
GET {{baseUrl}}/auth/me
Authorization: Bearer invalid-token

### Refresh session (should return 200 with new tokens)
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "YOUR_REFRESH_TOKEN"
}

### Refresh with invalid token (should return 401)
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "invalid-refresh-token"
}

### Logout (should return 200)
POST {{baseUrl}}/auth/logout
Content-Type: application/json
Authorization: Bearer {{tokenOutlook}}

{
  "refresh_token": "YOUR_REFRESH_TOKEN"
}

# ============================================================================
# G2: Session persists after reload
# ============================================================================

### Get current user after "reload" (should return 200)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{tokenOutlook}}

# ============================================================================
# G3: Navigation shows different content for logged in/out
# ============================================================================

# This is a frontend feature, not testable via API.

# ============================================================================
# G4: All can see property list and detail page
# ============================================================================

### Get all properties (should return 200)
GET {{baseUrl}}/properties

### Get a single property (should return 200)
GET {{baseUrl}}/properties/{{propertyIdOutlook}}

### Get a non-existent property (should return 404)
GET {{baseUrl}}/properties/nonexistent

# ============================================================================
# G5: Filtering on location, max price, guests
# ============================================================================

### Filter by location (should return 200)
GET {{baseUrl}}/properties?location=stockholm

### Filter by max price (should return 200)
GET {{baseUrl}}/properties?max_price=900

### Filter by guests (should return 200)
GET {{baseUrl}}/properties?guests=4

### Filter with invalid max_price (should return 400)
GET {{baseUrl}}/properties?max_price=abc

### Filter with invalid guests (should return 400)
GET {{baseUrl}}/properties?guests=0

### Filter with invalid sort (should return 400)
GET {{baseUrl}}/properties?sort=cheapest

# ============================================================================
# G6: Only logged-in users can create, edit, delete properties
# ============================================================================

### Create property without token (should return 401)
POST {{baseUrl}}/properties
Content-Type: application/json

{
  "title": "Test Property",
  "description": "A test property",
  "location": "Test City",
  "price_per_night": 500,
  "max_guests": 2
}

### Create property with token (should return 201)
POST {{baseUrl}}/properties
Content-Type: application/json
Authorization: Bearer {{tokenOutlook}}

{
  "title": "Test Property",
  "description": "A test property",
  "location": "Test City",
  "price_per_night": 500,
  "max_guests": 2
}

### Create property with invalid data (should return 400)
POST {{baseUrl}}/properties
Content-Type: application/json
Authorization: Bearer {{tokenOutlook}}

{
  "title": "",
  "description": "A test property",
  "location": "Test City",
  "price_per_night": -100,
  "max_guests": 0
}

### Update property without token (should return 401)
PUT {{baseUrl}}/properties/{{propertyIdOutlook}}
Content-Type: application/json

{
  "title": "Updated Property",
  "description": "Updated description",
  "location": "Updated City",
  "price_per_night": 600,
  "max_guests": 3
}

### Update own property (should return 200)
PUT {{baseUrl}}/properties/{{testPropertyId}}
Content-Type: application/json
Authorization: Bearer {{tokenOutlook}}

{
  "title": "Updated Test Property",
  "description": "Updated description",
  "location": "Updated City",
  "price_per_night": 600,
  "max_guests": 3
}

### Update someone else's property (should return 404)
PUT {{baseUrl}}/properties/{{propertyIdOutlook}}
Content-Type: application/json
Authorization: Bearer {{tokenYahoo}}

{
  "title": "Hacked Property",
  "description": "This should not work",
  "location": "Nowhere",
  "price_per_night": 1,
  "max_guests": 1
}

### Delete property without token (should return 401)
DELETE {{baseUrl}}/properties/{{propertyIdOutlook}}

### Delete own property (should return 200)
DELETE {{baseUrl}}/properties/{{testPropertyId}}
Authorization: Bearer {{tokenOutlook}}

### Delete someone else's property (should return 404)
DELETE {{baseUrl}}/properties/{{propertyIdOutlook}}
Authorization: Bearer {{tokenYahoo}}

